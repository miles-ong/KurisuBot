<ResourceDictionary xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:KurisuApp.Controls"
    xmlns:m="using:KurisuCore.Models">
  
    <ControlTheme x:Key="{x:Type c:CALinksList}" TargetType="c:CALinksList">
        <Setter Property="Template">
            <ControlTemplate TargetType="c:CALinksList">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{TemplateBinding ItemsSource}"
                        Background="{DynamicResource PrimaryInset}"
                        Padding="10"
                        CornerRadius="5">
                        <ItemsControl.ItemContainerTheme>
                            <ControlTheme TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,0,5"/>
                            </ControlTheme>
                        </ItemsControl.ItemContainerTheme>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:IKurisuDisplayItem">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0"
                                        FontSize="20"
                                        Text="{Binding DisplayName}"
                                        VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                        FontFamily="{DynamicResource Phosphor}"
                                        FontSize="15"
                                        Content="&#xe2e4;"
                                        Command="{Binding $parent[c:CALinksList].RemoveCommand}"
                                        CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
