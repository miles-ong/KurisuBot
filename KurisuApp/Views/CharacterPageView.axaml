<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:t="using:KurisuApp.Themes"
             xmlns:vm="clr-namespace:KurisuApp.ViewModels"
             xmlns:models="clr-namespace:KurisuCore.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="KurisuApp.Views.CharacterPageView"
             x:DataType="vm:CharacterPageViewModel">

    <Design.DataContext><vm:CharacterPageViewModel/></Design.DataContext>
       
    <Border Margin="20">
        <Grid RowDefinitions="Auto, Auto" RowSpacing="20">
            <AutoCompleteBox Grid.Row="0"
                x:Name="SearchBox"
                FontSize="30"
                ItemsSource="{Binding SearchResults}"
                SelectedItem="{Binding SelectedCharacter}"
                ValueMemberBinding="{Binding Name}"
                MinimumPrefixLength="2"
                MinimumPopulateDelay="0:0:0.3">
            </AutoCompleteBox>
            <Grid RowDefinitions="Auto, *" RowSpacing="10" Grid.Row="1">
                <TextBox Grid.Row="0"
                    FontSize="20"
                    PlaceholderText="Edit character name..."
                    Text="{Binding NameInput}">
                </TextBox>
                <t:IconButton Grid.Row="1"
                    IsVisible="{Binding IsAddMode}"
                    FontSize="20"
                    IconText="&#xe3d6;"
                    Content="Add Character"
                    Command="{Binding AddCharacterCommand}"/>
                <t:IconButton Grid.Row="1"
                    IsVisible="{Binding IsEditMode}"
                    FontSize="20" 
                    IconText="&#xe5d4;" 
                    Content="Apply Changes"
                    Command="{Binding ApplyChangesCommand}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
