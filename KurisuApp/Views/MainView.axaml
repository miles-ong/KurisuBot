<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="using:KurisuApp.Controls"
        xmlns:vm="clr-namespace:KurisuApp.ViewModels"
        xmlns:view="clr-namespace:KurisuApp.Views"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="KurisuApp.Views.MainView"
        x:DataType="vm:MainViewModel"
        Title="KurisuApp"
        Width="1920" Height="1080"
        MinWidth="1600" MinHeight="900">

    <Design.DataContext><vm:MainViewModel/></Design.DataContext>

    <Grid Background="{DynamicResource ResourceKey=PrimaryBackground}" ColumnDefinitions="Auto, *">
        <Border Grid.Column="0" Padding="20" Background="{DynamicResource ResourceKey=PrimaryForeground}">
            <Grid RowDefinitions="*, Auto">
                <StackPanel Grid.Row="0" Spacing="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{DynamicResource ResourceKey=GGSansBold}" FontSize="60">Kurisu</TextBlock>
                        <TextBlock FontFamily="{DynamicResource ResourceKey=GGSans}" FontSize="40">DB</TextBlock>
                    </StackPanel>
                    <c:IconButton
                        Classes.active="{Binding AnimePageIsActive}" 
                        HorizontalAlignment="Stretch" 
                        FontSize="40"
                        IconText="&#xeae6;" 
                        Content="Anime"  
                        Command="{Binding GoToAnimeCommand}"/>
                    <c:IconButton 
                        Classes.active="{Binding CharacterPageIsActive}"
                        HorizontalAlignment="Stretch"
                        FontSize="40" 
                        IconText="&#xe4c2;" 
                        Content="Characters" 
                        Command="{Binding GoToCharacterCommand}"/>
                    <c:IconButton 
                        Classes.active="{Binding VariantPageIsActive}" 
                        HorizontalAlignment="Stretch" 
                        FontSize="40"
                        IconText="&#xe46a;" 
                        Content="Variants"  
                        Command="{Binding GoToVariantCommand}"/>
                    <c:IconButton
                        Classes.active="{Binding PackPageIsActive}"
                        HorizontalAlignment="Stretch"
                        FontSize="40"
                        IconText="&#xe0f8;"
                        Content="Packs"
                        Command="{Binding GoToPackCommand}"/>
                </StackPanel>

                <Label Grid.Row="1" FontSize="20" Content="{Binding ApiStatus}"></Label>
            </Grid>
        </Border>
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
        
        <c:NotificationBox Grid.ColumnSpan="2"
            HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="0,0,0,10"
            ItemsSource="{Binding NotificationService.Notifications}"/>
    </Grid>
</Window>
