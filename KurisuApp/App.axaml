<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KurisuApp"
             x:Class="KurisuApp.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator></local:ViewLocator>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="Styles/AutoCompleteBoxStyles.axaml"></StyleInclude>
        <StyleInclude Source="Styles/BorderStyles.axaml"></StyleInclude>
        <StyleInclude Source="Styles/ButtonStyles.axaml"></StyleInclude>
        <StyleInclude Source="Styles/DefaultStyles.axaml"></StyleInclude>
        <StyleInclude Source="Styles/LabelStyles.axaml"></StyleInclude>
        <StyleInclude Source="Styles/TextBoxStyles.axaml"></StyleInclude>
    </Application.Styles>

    <Application.Resources>

        <!-- Controls -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <MergeResourceInclude Source="/Controls/IconButton.axaml"></MergeResourceInclude>
                <MergeResourceInclude Source="/Controls/CALinksList.axaml"></MergeResourceInclude>
                <MergeResourceInclude Source="/Controls/NotificationBox.axaml"></MergeResourceInclude>
                <MergeResourceInclude Source="/Controls/VariantsList.axaml"></MergeResourceInclude>
            </ResourceDictionary.MergedDictionaries>

            <!-- Colors -->
            <SolidColorBrush x:Key="PrimaryForeground">#3b3b3b</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryBackground">#2b2b2b</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryInset">#242424</SolidColorBrush>

            <SolidColorBrush x:Key="PrimaryElementForeground">#CFCFCF</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryElementBackground">#454545</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryElementOutline">#545353</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryElementHoverForeground">White</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryElementHoverBackground">#8c3232</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryElementHoverOutline">#ad3d3d</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryElementActiveBackground">#bf4343</SolidColorBrush>

            <SolidColorBrush x:Key="NotificationSuccessBackground">#3d612e</SolidColorBrush>
            <SolidColorBrush x:Key="NotificationFailBackground">#ad3d3d</SolidColorBrush>
            <SolidColorBrush x:Key="NotificationWarningBackground">#7a7836</SolidColorBrush>
            <SolidColorBrush x:Key="NotificationInfoBackground">#3b3b3b</SolidColorBrush>

            <!-- Fonts -->
            <FontFamily x:Key="GGSans">/Assets/Fonts/gg sans Regular.ttf#gg sans Normal</FontFamily>
            <FontFamily x:Key="GGSansMedium">/Assets/Fonts/gg sans Medium.ttf#gg sans Medium</FontFamily>
            <FontFamily x:Key="GGSansSemibold">/Assets/Fonts/gg sans Semibold.ttf#gg sans Semibold</FontFamily>
            <FontFamily x:Key="GGSansBold">/Assets/Fonts/gg sans Bold.ttf#gg sans</FontFamily>
            <FontFamily x:Key="Phosphor">/Assets/Fonts/Phosphor.ttf#Phosphor</FontFamily>
            <FontFamily x:Key="PhosphorFill">/Assets/Fonts/Phosphor-Fill.ttf#Phosphor</FontFamily>
    
        </ResourceDictionary>
    </Application.Resources>
</Application>