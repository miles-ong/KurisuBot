<Window xmlns="https://github.com/avaloniaui"
        xmlns:compilerservices="using:System.Runtime.CompilerServices"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
        Width="1600" Height="900"
        xmlns:vm="clr-namespace:KurisuDesktop.ViewModels" 
        xmlns:view="clr-namespace:KurisuDesktop.Views"
        x:Class="KurisuDesktop.Views.MainView"
        x:DataType="vm:MainViewModel"
        Title="KurisuDesktop">

    <Design.DataContext><vm:MainViewModel></vm:MainViewModel></Design.DataContext>
    
    <Grid Background="{DynamicResource ResourceKey=PrimaryBackground}" ColumnDefinitions="Auto, *">

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"></ContentControl>

        <Border Grid.Column="0" Padding="20" Background="{DynamicResource ResourceKey=SidebarBackgroundGradient}">
            <Grid RowDefinitions="*, Auto">

                <StackPanel Grid.Row="0" Spacing="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{DynamicResource ResourceKey=GGSansBold}" FontSize="60" FontWeight="Bold">Kurisu</TextBlock>
                        <TextBlock FontFamily="{DynamicResource ResourceKey=GGSans}" FontSize="40" FontWeight="SemiLight">DB</TextBlock>
                    </StackPanel>
                    <Button Classes.active="{Binding AnimePageIsActive}" HorizontalAlignment="Stretch" Command="{Binding GoToAnimeCommand}">
                        <StackPanel Orientation="Horizontal" Margin="5,0" Spacing="10">
                            <Label Classes="icon" Content="&#xeae6;"></Label>
                            <Label Content="Anime"></Label>
                        </StackPanel>
                    </Button>
                    <Button Classes.active="{Binding CharacterPageIsActive}" HorizontalAlignment="Stretch" Command="{Binding GoToCharacterCommand}">
                        <StackPanel Orientation="Horizontal" Margin="5,0" Spacing="10">
                            <Label Classes="icon" Content="&#xe4c2;"></Label>
                            <Label Content="Characters"></Label>
                        </StackPanel>
                    </Button>
                    <Button Classes.active="{Binding VariantPageIsActive}" HorizontalAlignment="Stretch" Command="{Binding GoToVariantCommand}">
                        <StackPanel Orientation="Horizontal" Margin="5,0" Spacing="10">
                            <Label Classes="icon" Content="&#xe46a;"></Label>
                            <Label Content="Variants"></Label>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Label Grid.Row="1" FontSize="30" Content="API Status:"></Label>
            </Grid>
        </Border>
    </Grid>
</Window>
