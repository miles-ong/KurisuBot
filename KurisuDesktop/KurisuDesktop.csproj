<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\Fonts\gg sans Bold.ttf" />
    <None Remove="Assets\Fonts\gg sans Medium.ttf" />
    <None Remove="Assets\Fonts\gg sans Regular.ttf" />
    <None Remove="Assets\Fonts\gg sans Semibold.ttf" />
    <None Remove="Assets\Fonts\Phosphor-Fill.ttf" />
    <None Remove="Assets\Fonts\Phosphor.ttf" />
    <None Remove="Assets\Images\AnimeIcon.svg" />
    <None Remove="Assets\Images\CharacterIcon.svg" />
    <None Remove="Assets\Images\VariantIcon.svg" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\gg sans Bold.ttf" />
    <AvaloniaResource Include="Assets\Fonts\gg sans Medium.ttf" />
    <AvaloniaResource Include="Assets\Fonts\gg sans Regular.ttf" />
    <AvaloniaResource Include="Assets\Fonts\gg sans Semibold.ttf" />
    <AvaloniaResource Include="Assets\Fonts\Phosphor-Fill.ttf" />
    <AvaloniaResource Include="Assets\Fonts\Phosphor.ttf" />
    <AvaloniaResource Include="Assets\Images\AnimeIcon.svg" />
    <AvaloniaResource Include="Assets\Images\CharacterIcon.svg" />
    <AvaloniaResource Include="Assets\Images\VariantIcon.svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KurisuCore\KurisuCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="MainView.axaml.cs">
      <DependentUpon>MainView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
